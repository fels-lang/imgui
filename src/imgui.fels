// Inside

// `text` as a C string in `buf`, cut to fit.
c :: fn(text: []const u8, buf: []u8) -> [*]const u8 {
    n := text.len;
    if n > buf.len - 1usize { n = buf.len - 1usize; }
    i: usize = 0usize;
    while i < n {
        buf[i] = text[i];
        i += 1usize;
    }
    buf[n] = 0u8;
    return buf.ptr;
}

