// imgui: Fels bindings to Dear ImGui (docking branch), with a ready window on Direct3D 11.
//
//   if !imgui::open("Notes", 1280, 800, imgui::DOCKING | imgui::KEYBOARD, "notes.ini") { return 1; }
//   while imgui::begin_frame() {
//       if imgui::begin("Hello") { imgui::text("Hello from Fels"); }
//       imgui::end();
//       imgui::end_frame(0.1, 0.1, 0.12);
//   }
//   imgui::close();
//
// Labels and other texts given to Dear ImGui are copied into a short C string (255 bytes); a
// longer one is cut. Text drawn with `text` has no such limit. Dear ImGui is immediate: every
// frame draws the whole UI again, and a widget answers in the same call (`button` is true in
// the frame it was clicked).

pub Vec2 :: struct { x: f32, y: f32 }
pub Vec4 :: struct { x: f32, y: f32, z: f32, w: f32 }

// One column a table is sorted by (`table_sort_specs`).
pub ColumnSort :: struct {
    user_id: u32,
    index: i16,      // the column
    order: i16,      // 0 for the first sort key, 1 for the second
    direction: u8,   // ASCENDING or DESCENDING
}

pub SortSpecs :: struct {
    specs: usize,    // *ColumnSort
    count: i32,
    dirty: bool,     // the sort changed: sort the rows again and call `table_sorted`
}

// The window

// Flags of `open`.
pub DOCKING :: 1;    // panels dock into each other and into the window
pub VIEWPORTS :: 2;  // panels can leave the main window
pub KEYBOARD :: 4;   // the keyboard moves between widgets

// Open the main window, `width` x `height` at 96 dpi. `ini_path` is where the layout of the
// panels is kept between runs; empty keeps none, or lets the program keep it with
// `layout_text`, `layout_changed` and `load_layout`.
pub open :: fn(title: []const u8, width: i32, height: i32, flags: i32, ini_path: []const u8) -> bool {
    t: [256]u8 = .{};
    ini: [256]u8 = .{};
    if ini_path.len == 0 { return fels_app_open(c(title, t[:]), width, height, flags, 0usize) == 1; }
    path := c(ini_path, ini[:]);
    return fels_app_open(c(title, t[:]), width, height, flags, unsafe path as usize) == 1;
}

// Begin a frame; false when the window was closed (then `close`).
pub begin_frame :: fn() -> bool { return fels_app_begin_frame() == 1; }

// Draw the frame on the background r, g, b (0 to 1).
pub end_frame :: fn(r: f32, g: f32, b: f32) { fels_app_end_frame(r, g, b); }

pub close :: fn() { fels_app_close(); }

// Ask the window to close, as its close button does.
pub quit :: fn() { fels_app_quit(); }

// The scale of the main monitor: 1 at 96 dpi.
pub dpi_scale :: fn() -> f32 { return fels_app_dpi_scale(); }

// Load a TrueType font file as the default font, `size` pixels at 96 dpi. Before the first
// frame.
pub load_font :: fn(path: []const u8, size: f32) -> bool {
    p: [256]u8 = .{};
    return fels_app_load_font(c(path, p[:]), size) == 1;
}

// The style

pub set_color :: fn(idx: i32, color: Vec4) { fels_app_set_color(idx, color.x, color.y, color.z, color.w); }
pub set_rounding :: fn(window: f32, frame: f32, tab: f32, scrollbar: f32) { fels_app_set_rounding(window, frame, tab, scrollbar); }
pub set_spacing :: fn(frame_x: f32, frame_y: f32, item_x: f32, item_y: f32, cell_x: f32, cell_y: f32) {
    fels_app_set_spacing(frame_x, frame_y, item_x, item_y, cell_x, cell_y);
}
pub set_borders :: fn(window: f32, frame: f32, tab: f32) { fels_app_set_borders(window, frame, tab); }

// Scale every text: 1 for the size of `load_font`.
pub set_font_scale :: fn(scale: f32) { fels_app_set_font_scale(scale); }

// The file dialog of Windows to open a file; the path chosen (in `out`), or null when it was
// closed without one. `filter` has its parts between `|`: "CSV files|*.csv|All files|*.*".
pub open_file_dialog :: fn(title: []const u8, filter: []const u8, out: []u8) -> ?[]const u8 {
    return file_dialog(0, title, filter, out);
}

// The file dialog of Windows to save a file under a name; `out` may hold a name to start with.
pub save_file_dialog :: fn(title: []const u8, filter: []const u8, out: []u8) -> ?[]const u8 {
    return file_dialog(1, title, filter, out);
}

file_dialog :: fn(save: i32, title: []const u8, filter: []const u8, out: []u8) -> ?[]const u8 {
    t: [256]u8 = .{};
    f: [512]u8 = .{};
    n := fels_app_file_dialog(save, c(title, t[:]), c(filter, f[:]), out.ptr, out.len as i32);
    if n <= 0 { return null; }
    return out[0usize..(n as usize)];
}

// The title bar of the window: dark or light buttons and text, and the color of the bar (on
// Windows 11), to go with the colors of the panels.
pub set_title_bar :: fn(dark: bool, color: Vec4) {
    d: i32 = 0;
    if dark { d = 1; }
    fels_app_set_title_bar(d, color.x, color.y, color.z);
}

// Windows and layout

// A window (a panel); `end` it whether this is true or not.
pub begin :: fn(name: []const u8) -> bool {
    n: [256]u8 = .{};
    return igBegin(c(name, n[:]), 0usize, 0);
}

// A window with a close button that sets `*open` false, and window flags.
pub begin_with :: fn(name: []const u8, open: *bool, flags: i32) -> bool {
    n: [256]u8 = .{};
    return igBegin(c(name, n[:]), unsafe open as usize, flags);
}

pub end :: fn() { igEnd(); }

// The dock space over the whole main window, under its menu bar; its id.
pub dock_space :: fn() -> u32 { return igDockSpaceOverViewport(0u32, igGetMainViewport(), PASSTHRU_CENTRAL_NODE, 0usize); }

// Put the window `name` into the dock node `node` (from `dock_space`) before it first shows.
pub dock_window :: fn(name: []const u8, node: u32) {
    n: [256]u8 = .{};
    igDockBuilderDockWindow(c(name, n[:]), node);
}

// Layouts: lay out the dock space anew, for a first start or a layout preset.
//
//   imgui::layout_begin(dock);
//   rest: u32 = 0u32;
//   left := imgui::layout_split(dock, imgui::DIR_LEFT, 0.25, &rest);
//   imgui::dock_window("Accounts", left);
//   imgui::dock_window("Positions", rest);
//   imgui::layout_end(dock);

// Empty the dock node `node` (from `dock_space`) to lay it out anew, at the size of the window.
pub layout_begin :: fn(node: u32) {
    igDockBuilderRemoveNode(node);
    id := igDockBuilderAddNode(node, DOCK_SPACE_NODE | PASSTHRU_CENTRAL_NODE);
    igDockBuilderSetNodeSize(node, work_size());
}

// Split `node`: the part toward `dir` (DIR_*) gets `ratio` of it and is returned; the id of the
// other part goes to `*rest`.
pub layout_split :: fn(node: u32, dir: i32, ratio: f32, rest: *u32) -> u32 {
    part: u32 = 0u32;
    id := igDockBuilderSplitNode(node, dir, ratio, &part, rest);
    return part;
}

pub layout_end :: fn(node: u32) { igDockBuilderFinish(node); }

// The layout of every panel (where it is docked, its size, the columns of its tables) as the
// text of an ini file, to keep it elsewhere. Valid until the next call: copy it to keep it.
pub layout_text :: fn() -> []const u8 {
    size: usize = 0usize;
    p := igSaveIniSettingsToMemory(&size);
    return unsafe core::slice_from_raw_parts(u8, p, size);
}

// Whether the layout changed since the last call, so that `layout_text` should be kept anew.
// Only without an ini file (`open` with an empty `ini_path`).
pub layout_changed :: fn() -> bool { return fels_app_layout_changed() == 1; }

// Take the layout from `text` (from `layout_text`). Before the first `begin_frame`, or between
// `end_frame` and the next `begin_frame`.
pub load_layout :: fn(text: []const u8) {
    igLoadIniSettingsFromMemory(text.ptr, text.len);
}

// The size of the main window without its menu bar.
pub work_size :: fn() -> Vec2 {
    vp := igGetMainViewport();
    size: Vec2 = unsafe *core::ptr_from_int(*Vec2, vp + 40usize);
    return size;
}

pub set_next_window_size :: fn(size: Vec2, cond: i32) { igSetNextWindowSize(size, cond); }

// Put the next window in the middle of the main window (`cond`: ALWAYS, FIRST_USE_EVER, ...).
pub center_next_window :: fn(cond: i32) {
    vp := igGetMainViewport();
    pos: Vec2 = unsafe *core::ptr_from_int(*Vec2, vp + 32usize);
    size := work_size();
    center: Vec2 = .{ pos.x + size.x * 0.5, pos.y + size.y * 0.5 };
    pivot: Vec2 = .{ 0.5, 0.5 };
    igSetNextWindowPos(center, cond, pivot);
}
pub set_window_focus :: fn(name: []const u8) {
    n: [256]u8 = .{};
    igSetWindowFocus_Str(c(name, n[:]));
}

pub child_begin :: fn(id: []const u8, size: Vec2, border: bool) -> bool {
    n: [256]u8 = .{};
    flags: i32 = 0;
    if border { flags = 1; }
    return igBeginChild_Str(c(id, n[:]), size, flags, 0);
}
pub child_end :: fn() { igEndChild(); }

pub same_line :: fn() { igSameLine(0.0, -1.0); }
pub separator :: fn() { igSeparator(); }
pub dummy :: fn(size: Vec2) { igDummy(size); }
pub avail :: fn() -> Vec2 { return igGetContentRegionAvail(); }

// Where the next item goes, on the screen: the place to draw at.
pub cursor_screen_pos :: fn() -> Vec2 { return igGetCursorScreenPos(); }

// A filled rectangle from `min` to `max` (screen positions) in the current window, its corners
// rounded by `rounding`. Draw, then `dummy` the size, so that the next item goes below.
pub draw_rect :: fn(min: Vec2, max: Vec2, color: Vec4, rounding: f32) {
    ImDrawList_AddRectFilled(igGetWindowDrawList(), min, max, igGetColorU32_Vec4(color), rounding, 0);
}

// A line from `from` to `to` (screen positions) in the current window.
pub draw_line :: fn(from: Vec2, to: Vec2, color: Vec4, thickness: f32) {
    ImDrawList_AddLine(igGetWindowDrawList(), from, to, igGetColorU32_Vec4(color), thickness);
}
pub frame_height :: fn() -> f32 { return igGetFrameHeight(); }
pub cursor_x :: fn() -> f32 { return igGetCursorPosX(); }
pub set_cursor_x :: fn(x: f32) { igSetCursorPosX(x); }
pub set_next_item_width :: fn(w: f32) { igSetNextItemWidth(w); }
pub push_id :: fn(id: i32) { igPushID_Int(id); }
pub pop_id :: fn() { igPopID(); }
pub begin_disabled :: fn(disabled: bool) { igBeginDisabled(disabled); }
pub end_disabled :: fn() { igEndDisabled(); }

// The size `t` takes in the current font.
pub text_size :: fn(t: []const u8) -> Vec2 {
    if t.len == 0 {
        none: Vec2 = .{ 0.0, 0.0 };
        return none;
    }
    end_at: usize = unsafe (t.ptr as usize) + t.len;
    return igCalcTextSize(t.ptr, end_at, false, -1.0);
}

// Widgets

// `t` as it is, any length.
pub text :: fn(t: []const u8) {
    if t.len == 0 {
        igTextUnformatted("".ptr, 0usize);
        return;
    }
    end_at: usize = unsafe (t.ptr as usize) + t.len;
    igTextUnformatted(t.ptr, end_at);
}

// `t` in `color`.
pub text_colored :: fn(color: Vec4, t: []const u8) {
    igPushStyleColor_Vec4(COL_TEXT, color);
    text(t);
    igPopStyleColor(1);
}

// `t` right-aligned in the space that is left on the line (a number in a table cell).
pub text_right :: fn(t: []const u8) {
    w := text_size(t).x;
    room := avail().x;
    if room > w { igSetCursorPosX(igGetCursorPosX() + room - w); }
    text(t);
}

// `t` right-aligned, in `color`.
pub text_right_colored :: fn(color: Vec4, t: []const u8) {
    igPushStyleColor_Vec4(COL_TEXT, color);
    text_right(t);
    igPopStyleColor(1);
}

pub button :: fn(label: []const u8) -> bool {
    l: [256]u8 = .{};
    size: Vec2 = .{ 0.0, 0.0 };
    return igButton(c(label, l[:]), size);
}

pub checkbox :: fn(label: []const u8, value: *bool) -> bool {
    l: [256]u8 = .{};
    return igCheckbox(c(label, l[:]), value);
}

// A row that can be selected; with `span_all`, it is as wide as the table row.
pub selectable :: fn(label: []const u8, selected: bool, span_all: bool) -> bool {
    l: [256]u8 = .{};
    size: Vec2 = .{ 0.0, 0.0 };
    flags: i32 = 0;
    if span_all { flags = SELECTABLE_SPAN_ALL_COLUMNS; }
    return igSelectable_Bool(c(label, l[:]), selected, flags, size);
}

// A text field over `buf`, which holds a C string (the text and a NUL). True when it changed
// (or, with INPUT_ENTER_RETURNS_TRUE, when Enter was pressed).
pub input_text :: fn(label: []const u8, buf: []u8, flags: i32) -> bool {
    l: [256]u8 = .{};
    return igInputText(c(label, l[:]), buf.ptr, buf.len, flags, 0usize, 0usize);
}

// A text field like `input_text` that shows `hint` in grey while it is empty.
pub input_hint :: fn(label: []const u8, hint: []const u8, buf: []u8, flags: i32) -> bool {
    l: [256]u8 = .{};
    h: [256]u8 = .{};
    return igInputTextWithHint(c(label, l[:]), c(hint, h[:]), buf.ptr, buf.len, flags, 0usize, 0usize);
}

// What Dear ImGui reads as "find the range yourself" (the largest f32, written out: Fels has
// no exponent notation).
FLT_MAX :: 340282346638528859811704183484516925440.0;

// A line through `values`, `size` big (0 for the width or height that is left); the line spans
// `low` to `high`, or the values' own range when both are 0. `overlay` is written over it.
pub plot_lines :: fn(label: []const u8, values: []const f32, overlay: []const u8, low: f32, high: f32, size: Vec2) {
    l: [256]u8 = .{};
    o: [256]u8 = .{};
    lo := low;
    hi := high;
    if lo == 0.0 && hi == 0.0 {
        lo = FLT_MAX;
        hi = FLT_MAX;
    }
    igPlotLines_FloatPtr(c(label, l[:]), values.ptr, values.len as i32, 0, c(overlay, o[:]), lo, hi, size, 4);
}

// The text of a field's buffer, up to its NUL.
pub buffer_text :: fn(buf: []const u8) -> []const u8 {
    n: usize = 0usize;
    while n < buf.len && buf[n] != 0u8 { n += 1usize; }
    return buf[0usize..n];
}

// Put `t` into a field's buffer, cut to fit, with its NUL.
pub set_buffer :: fn(buf: []u8, t: []const u8) {
    gone := c(t, buf);
}

pub combo_begin :: fn(label: []const u8, preview: []const u8) -> bool {
    l: [256]u8 = .{};
    p: [256]u8 = .{};
    return igBeginCombo(c(label, l[:]), c(preview, p[:]), 0);
}
pub combo_end :: fn() { igEndCombo(); }

pub is_item_hovered :: fn() -> bool { return igIsItemHovered(0); }

// Whether the last item was double-clicked (with the left button) in this frame.
pub is_item_double_clicked :: fn() -> bool { return igIsItemHovered(0) && igIsMouseDoubleClicked_Nil(0); }

// A tooltip with `t` over the last item.
pub tooltip :: fn(t: []const u8) {
    if igBeginTooltip() {
        text(t);
        igEndTooltip();
    }
}

// Whether the keys `chord` (a key with MOD_CTRL and the like) were pressed this frame.
pub pressed :: fn(chord: i32) -> bool { return igIsKeyChordPressed_Nil(chord); }

pub set_keyboard_focus_here :: fn() { igSetKeyboardFocusHere(0); }
pub set_item_default_focus :: fn() { igSetItemDefaultFocus(); }

pub show_demo :: fn(open: *bool) { igShowDemoWindow(open); }

// Menus

pub main_menu_bar_begin :: fn() -> bool { return igBeginMainMenuBar(); }
pub main_menu_bar_end :: fn() { igEndMainMenuBar(); }

pub menu_begin :: fn(label: []const u8) -> bool {
    l: [256]u8 = .{};
    return igBeginMenu(c(label, l[:]), true);
}
pub menu_end :: fn() { igEndMenu(); }

// A menu entry with a key shown beside it ("Ctrl+N", or empty); true when chosen.
pub menu_item :: fn(label: []const u8, shortcut: []const u8, enabled: bool) -> bool {
    l: [256]u8 = .{};
    s: [64]u8 = .{};
    return igMenuItem_Bool(c(label, l[:]), c(shortcut, s[:]), false, enabled);
}

// A menu entry that switches `*on`.
pub menu_toggle :: fn(label: []const u8, on: *bool) -> bool {
    l: [256]u8 = .{};
    return igMenuItem_BoolPtr(c(label, l[:]), "".ptr, on, true);
}

// Popups

pub popup_open :: fn(id: []const u8) {
    n: [256]u8 = .{};
    igOpenPopup_Str(c(id, n[:]), 0);
}

// A modal popup; `popup_end` it only when this is true.
pub popup_modal_begin :: fn(name: []const u8) -> bool {
    n: [256]u8 = .{};
    return igBeginPopupModal(c(name, n[:]), 0usize, ALWAYS_AUTO_RESIZE);
}
// A menu that a right click on the last item opens; `popup_end` it only when this is true.
pub context_menu_begin :: fn(id: []const u8) -> bool {
    n: [256]u8 = .{};
    return igBeginPopupContextItem(c(id, n[:]), POPUP_MOUSE_RIGHT);
}
pub popup_close :: fn() { igCloseCurrentPopup(); }
pub popup_end :: fn() { igEndPopup(); }

// Tabs

// A row of tabs; `tab_bar_end` it only when this is true.
pub tab_bar_begin :: fn(id: []const u8) -> bool {
    n: [256]u8 = .{};
    return igBeginTabBar(c(id, n[:]), 0);
}
pub tab_bar_end :: fn() { igEndTabBar(); }

// A tab of the bar; what is drawn while it is true is its page; `tab_item_end` it only then.
pub tab_item_begin :: fn(label: []const u8) -> bool {
    n: [256]u8 = .{};
    return igBeginTabItem(c(label, n[:]), 0usize, 0);
}
pub tab_item_end :: fn() { igEndTabItem(); }

// Tables

// A table of `columns` columns; `table_end` it only when this is true.
pub table_begin :: fn(id: []const u8, columns: i32, flags: i32) -> bool {
    n: [256]u8 = .{};
    size: Vec2 = .{ 0.0, 0.0 };
    return igBeginTable(c(id, n[:]), columns, flags, size, 0.0);
}
pub table_end :: fn() { igEndTable(); }

// Declare a column: its header, its flags (COLUMN_*), and a width (0 for automatic).
pub table_column :: fn(label: []const u8, flags: i32, width: f32) {
    l: [256]u8 = .{};
    igTableSetupColumn(c(label, l[:]), flags, width, 0u32);
}

// Keep the first `rows` rows (the headers) and `cols` columns in view when scrolling.
pub table_freeze :: fn(cols: i32, rows: i32) { igTableSetupScrollFreeze(cols, rows); }
pub table_headers :: fn() { igTableHeadersRow(); }
pub table_row :: fn() { igTableNextRow(0, 0.0); }
pub table_next_column :: fn() -> bool { return igTableNextColumn(); }
pub table_column_index :: fn(column: i32) -> bool { return igTableSetColumnIndex(column); }

// How the table is sorted, or null when it is not sortable. When `dirty` is true, sort the
// rows and call `table_sorted`.
pub table_sort_specs :: fn() -> ?SortSpecs {
    p := igTableGetSortSpecs();
    if p == 0usize { return null; }
    specs: SortSpecs = unsafe *core::ptr_from_int(*SortSpecs, p);
    return specs;
}

// The `i`th sort key of `specs`.
pub sort_column :: fn(specs: SortSpecs, i: i32) -> ColumnSort {
    at: usize = specs.specs + (i as usize) * 12usize;
    col: ColumnSort = unsafe *core::ptr_from_int(*ColumnSort, at);
    return col;
}

// Say the rows are sorted the way the specs ask.
pub table_sorted :: fn() {
    p := igTableGetSortSpecs();
    if p == 0usize { return; }
    specs := unsafe core::ptr_from_int(*SortSpecs, p);
    specs.dirty = false;
}

// Constants

// Window flags
pub NO_TITLE_BAR :: 1;
pub NO_RESIZE :: 2;
pub NO_MOVE :: 4;
pub NO_COLLAPSE :: 32;
pub ALWAYS_AUTO_RESIZE :: 64;
pub NO_SAVED_SETTINGS :: 256;
pub MENU_BAR :: 1024;
pub NO_DOCKING :: 524288;

// Popup flags
pub POPUP_MOUSE_RIGHT :: 8;

// Dock space flags
pub PASSTHRU_CENTRAL_NODE :: 8;
pub DOCK_SPACE_NODE :: 1024;

// Directions of `layout_split`
pub DIR_LEFT :: 0;
pub DIR_RIGHT :: 1;
pub DIR_UP :: 2;
pub DIR_DOWN :: 3;

// Table flags
pub TABLE_RESIZABLE :: 1;
pub TABLE_REORDERABLE :: 2;
pub TABLE_HIDEABLE :: 4;
pub TABLE_SORTABLE :: 8;
pub TABLE_CONTEXT_MENU_IN_BODY :: 32;
pub TABLE_ROW_BG :: 64;
pub TABLE_BORDERS_INNER_H :: 128;
pub TABLE_BORDERS_OUTER_H :: 256;
pub TABLE_BORDERS_INNER_V :: 512;
pub TABLE_BORDERS_OUTER_V :: 1024;
pub TABLE_SIZING_FIXED_FIT :: 8192;
pub TABLE_SIZING_STRETCH_PROP :: 24576;
pub TABLE_SCROLL_X :: 16777216;
pub TABLE_SCROLL_Y :: 33554432;
pub TABLE_SORT_MULTI :: 67108864;
pub TABLE_SORT_TRISTATE :: 134217728;
pub TABLE_HIGHLIGHT_HOVERED_COLUMN :: 268435456;

// Table column flags
pub COLUMN_DEFAULT_HIDE :: 2;
pub COLUMN_DEFAULT_SORT :: 4;
pub COLUMN_WIDTH_STRETCH :: 8;
pub COLUMN_WIDTH_FIXED :: 16;
pub COLUMN_NO_REORDER :: 64;
pub COLUMN_NO_HIDE :: 128;
pub COLUMN_NO_SORT :: 512;
pub COLUMN_PREFER_SORT_DESCENDING :: 32768;

// Sort directions
pub ASCENDING :: 1u8;
pub DESCENDING :: 2u8;

// Selectable and input flags
pub SELECTABLE_SPAN_ALL_COLUMNS :: 2;
pub SELECTABLE_ALLOW_DOUBLE_CLICK :: 4;
pub INPUT_CHARS_DECIMAL :: 1;
pub INPUT_ENTER_RETURNS_TRUE :: 64;
pub INPUT_AUTO_SELECT_ALL :: 4096;

// Conditions
pub ALWAYS :: 1;
pub FIRST_USE_EVER :: 4;
pub APPEARING :: 8;

// Keys (for `pressed`; the letters and digits as on a US keyboard, so KEY_EQUAL is the
// key with + on a German one) and modifiers
pub KEY_TAB :: 512;
pub KEY_LEFT :: 513;
pub KEY_RIGHT :: 514;
pub KEY_UP :: 515;
pub KEY_DOWN :: 516;
pub KEY_PAGE_UP :: 517;
pub KEY_PAGE_DOWN :: 518;
pub KEY_HOME :: 519;
pub KEY_END :: 520;
pub KEY_INSERT :: 521;
pub KEY_DELETE :: 522;
pub KEY_BACKSPACE :: 523;
pub KEY_SPACE :: 524;
pub KEY_ENTER :: 525;
pub KEY_ESCAPE :: 526;
pub KEY_0 :: 536;
pub KEY_1 :: 537;
pub KEY_2 :: 538;
pub KEY_3 :: 539;
pub KEY_4 :: 540;
pub KEY_5 :: 541;
pub KEY_6 :: 542;
pub KEY_7 :: 543;
pub KEY_8 :: 544;
pub KEY_9 :: 545;
pub KEY_A :: 546;
pub KEY_B :: 547;
pub KEY_C :: 548;
pub KEY_D :: 549;
pub KEY_E :: 550;
pub KEY_F :: 551;
pub KEY_G :: 552;
pub KEY_H :: 553;
pub KEY_I :: 554;
pub KEY_J :: 555;
pub KEY_K :: 556;
pub KEY_L :: 557;
pub KEY_M :: 558;
pub KEY_N :: 559;
pub KEY_O :: 560;
pub KEY_P :: 561;
pub KEY_Q :: 562;
pub KEY_R :: 563;
pub KEY_S :: 564;
pub KEY_T :: 565;
pub KEY_U :: 566;
