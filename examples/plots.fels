// Plots with ImPlot: a line over dates with its area, bars in groups, a pie and a heatmap.
#import imgui;
#import imgui.{ Vec4 };
#import imgui.plot;

main :: fn() -> i32 {
    if !imgui::open("Fels + ImPlot", 1280, 800, imgui::DOCKING, "plots.ini") { return 1; }
    teal: Vec4 = .{ 0.16, 0.66, 0.70, 1.0 };
    amber: Vec4 = .{ 0.92, 0.66, 0.26, 1.0 };
    colors: [4]Vec4 = .{ teal, amber, .{ 0.55, 0.47, 0.85, 1.0 }, .{ 0.85, 0.40, 0.40, 1.0 } };
    plot::style(colors[:], true);

    // a year of days (seconds since 1970) and a value that wanders
    days: [365]f64 = .{};
    values: [365]f64 = .{};
    invested: [365]f64 = .{};
    v: f64 = 10000.0;
    i: usize = 0usize;
    while i < 365usize {
        days[i] = (1735689600 + (i as i64) * 86400) as f64;
        step := (((i * 7919usize) % 101usize) as f64) - 48.0;
        v = v + step * 3.0 + 4.0;
        values[i] = v;
        invested[i] = 10000.0 + ((i / 30usize) as f64) * 500.0;
        i += 1usize;
    }
    years: [4]f64 = .{ 2022.0, 2023.0, 2024.0, 2025.0 };
    groups: [8]f64 = .{ 320.0, 410.0, 380.0, 520.0, 120.0, 160.0, 210.0, 180.0 };
    group_names: [2][]const u8 = .{ "Dividenden", "Zinsen" };
    year_names: [4][]const u8 = .{ "2022", "2023", "2024", "2025" };
    parts: [4]f64 = .{ 58.0, 21.6, 20.4, 0.0 };
    part_names: [4][]const u8 = .{ "Aktien", "Anleihen", "Liquidität", "Sonstiges" };
    months: [24]f64 = .{ 1.2, -0.4, 2.1, 0.8, -1.5, 0.3, 1.9, 2.4, -3.1, 0.6, 1.1, 2.2, 0.4, 1.8, -0.9, 2.6, 0.1, -0.7, 1.3, 0.9, -2.2, 3.0, 0.5, 1.4 };

    red_to_green: [3]Vec4 = .{ .{ 0.85, 0.33, 0.30, 1.0 }, .{ 0.20, 0.22, 0.25, 1.0 }, .{ 0.30, 0.76, 0.54, 1.0 } };
    gains := plot::add_colormap(red_to_green[:], false);
    first := true;
    while imgui::begin_frame() {
        dock := imgui::dock_space();
        if first {
            // two by two
            imgui::layout_begin(dock);
            right: u32 = 0u32;
            left := imgui::layout_split(dock, imgui::DIR_LEFT, 0.5, &right);
            left_down: u32 = 0u32;
            left_up := imgui::layout_split(left, imgui::DIR_UP, 0.5, &left_down);
            right_down: u32 = 0u32;
            right_up := imgui::layout_split(right, imgui::DIR_UP, 0.5, &right_down);
            imgui::dock_window("Vermögen", left_up);
            imgui::dock_window("Erträge", right_up);
            imgui::dock_window("Allokation", left_down);
            imgui::dock_window("Monate", right_down);
            imgui::layout_end(dock);
            first = false;
        }
        if imgui::begin("Vermögen") {
            if plot::begin("##wealth", -1.0, -1.0, plot::NO_TITLE) {
                plot::axes("", "", plot::AXIS_AUTO_FIT, plot::AXIS_AUTO_FIT);
                plot::axis_dates(plot::X1);
                plot::axis_format(plot::Y1, "%.0f EUR");
                plot::legend(plot::NORTH_WEST, 0);
                plot::shaded("##area", days[:], values[:], 0.0, teal, 0.20, plot::ITEM_NO_LEGEND);
                plot::line("Wert", days[:], values[:], teal, 2.0, 0);
                plot::stairs("Eingezahlt", days[:], invested[:], amber, 1.5, 0);
                plot::tag_y(values[364], teal, "jetzt");
                plot::end();
            }
        }
        imgui::end();
        if imgui::begin("Erträge") {
            if plot::begin("Erträge je Jahr", -1.0, -1.0, 0) {
                plot::axes("", "EUR", plot::AXIS_AUTO_FIT, plot::AXIS_AUTO_FIT);
                plot::axis_ticks(plot::X1, years[:], year_names[:], false);
                plot::bar_groups(group_names[:], groups[:], 4usize, 0.6, 2022.0, plot::BAR_GROUPS_STACKED);
                plot::end();
            }
        }
        imgui::end();
        if imgui::begin("Allokation") {
            room := imgui::avail();
            side := room.x;
            if room.y < side { side = room.y; }
            if plot::begin("##pie", side, side, plot::NO_TITLE | plot::EQUAL | plot::NO_MOUSE_TEXT) {
                plot::axes("", "", plot::AXIS_NO_DECORATIONS, plot::AXIS_NO_DECORATIONS);
                plot::axis_limits(plot::X1, 0.0, 1.0, plot::ONCE);
                plot::axis_limits(plot::Y1, 0.0, 1.0, plot::ONCE);
                plot::pie(part_names[:], parts[:], 0.5, 0.5, 0.4, "%.1f %%", 90.0, plot::PIE_NORMALIZE);
                plot::end();
            }
        }
        imgui::end();
        if imgui::begin("Monate") {
            plot::push_colormap(gains);
            if plot::begin("##months", imgui::avail().x - 90.0, -1.0, plot::NO_TITLE | plot::NO_LEGEND) {
                plot::axes("", "", plot::AXIS_NO_DECORATIONS, plot::AXIS_NO_DECORATIONS);
                plot::heatmap("Rendite", months[:], 2, 12, -3.0, 3.0, "%.1f", 0.0, 0.0, 12.0, 2.0, 0);
                plot::end();
            }
            imgui::same_line();
            plot::colormap_scale("##scale", -3.0, 3.0, 80.0, -1.0, "%.0f %%", gains);
            plot::pop_colormap();
        }
        imgui::end();
        imgui::end_frame(0.10, 0.11, 0.12);
    }
    imgui::close();
    return 0;
}
